# ===========================================================================
# Google Drive Download Relay - example configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# The relay loads `.env` automatically when it exists (real environment
# variables always win over the file). Set RELAY_ENV_FILE to use another path.
#
# NEVER commit real tokens. This file must only ever contain placeholders.
# ===========================================================================

# ---------------------------------------------------------------------------
# Google OAuth credentials (REQUIRED for any Drive access)
# ---------------------------------------------------------------------------
# Mode 1 - access token only (temporary / personal testing):
#   Set GOOGLE_ACCESS_TOKEN and leave the rest empty.
#   When the token expires the relay returns a clear 401 and cannot recover.
#
# Mode 2 - access + refresh token (recommended, self-healing):
#   Set all four values below. The relay refreshes the access token
#   automatically, including on a 401 from the Drive API.
#
#   Refresh-only bootstrapping also works: leave GOOGLE_ACCESS_TOKEN empty and
#   set the refresh token + client id/secret; the relay fetches an access token
#   on first use.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token endpoint. Only change this for testing.
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token

# Refresh the access token this long before it actually expires.
GOOGLE_REFRESH_SKEW=2m

# Timeout for a single call to the Google token endpoint.
GOOGLE_TOKEN_TIMEOUT=20s

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
RELAY_ADDR=:8080
RELAY_READ_HEADER_TIMEOUT=15s
RELAY_IDLE_TIMEOUT=120s
RELAY_SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Relay access control (strongly recommended when reachable by others)
# ---------------------------------------------------------------------------
# When set, every /api/* and /download request must present this key, either
# as `X-API-Key: <key>`, `Authorization: Bearer <key>`, the `key` query
# parameter, or a browser session cookie created via POST /api/session.
RELAY_API_KEY=

# Force API key to be required (default: true when RELAY_API_KEY is set).
# RELAY_REQUIRE_API_KEY=true

# Browser session lifetime created by POST /api/session.
RELAY_SESSION_TTL=12h

# ---------------------------------------------------------------------------
# Rate limiting (per client IP)
# ---------------------------------------------------------------------------
RELAY_RATE_LIMIT_ENABLED=true
RELAY_RATE_LIMIT_RPS=10
RELAY_RATE_LIMIT_BURST=30

# Trust X-Forwarded-For / X-Real-IP for client IP detection.
# Enable ONLY when running behind a reverse proxy you control.
RELAY_TRUST_PROXY=false

# Comma separated list of allowed CORS origins. Empty disables CORS headers.
RELAY_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Transfer limits
# ---------------------------------------------------------------------------
# Refuse files larger than this. Accepts plain bytes or KB/MB/GB/TB suffixes.
# 0 or "unlimited" disables the check.
RELAY_MAX_FILE_SIZE=0

# Throttle the relay's own output, in bytes per second, per stream.
# 0 or "unlimited" disables throttling. Example: 2MB
RELAY_BANDWIDTH_LIMIT=0

# Copy buffer size used for streaming (4KB - 1MB).
RELAY_STREAM_BUFFER_SIZE=64KB

# Maximum simultaneous downloads. 0 disables the limit.
RELAY_MAX_CONCURRENT_STREAMS=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
RELAY_LOG_LEVEL=info

# text | json
RELAY_LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Web interface
# ---------------------------------------------------------------------------
RELAY_WEB_UI_ENABLED=true